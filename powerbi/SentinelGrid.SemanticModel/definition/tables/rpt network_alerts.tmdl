table 'rpt network_alerts'
	lineageTag: 457a2b65-99f5-5573-a660-b8eb3340e3f2

	measure 'Network records' = COUNTROWS('rpt network_alerts') + 0
		formatString: #,0
		lineageTag: bda7c280-f0c1-576a-a689-bb92f8b01967

	measure 'Controlled tests' = CALCULATE([Network records], 'rpt network_alerts'[observation_context] = "Controlled validation") + 0
		formatString: #,0
		lineageTag: 1cd02d19-ab2d-576f-9110-8bfdf590a4e0

	measure 'Unclassified alerts' = CALCULATE([Network records], 'rpt network_alerts'[observation_context] = "Unclassified") + 0
		formatString: #,0
		lineageTag: 03d02f16-ba14-5399-9e77-353ee7dd25cf

	measure 'Network signatures' = DISTINCTCOUNTNOBLANK('rpt network_alerts'[signature_id]) + 0
		formatString: #,0
		lineageTag: 8ad489d2-e841-544d-a266-898ca7f7364d

